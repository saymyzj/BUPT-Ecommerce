              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  const list = json.data.records || json.data.list || json.data.content || [];",
                  "  if (list.length > 0) pm.environment.set('orderId', list[0].orderId || list[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
