    },
    {
      "name": "09 B+ Production Hardening",
      "description": "Optional administrator recovery demo. These endpoints are not part of the normal customer shopping flow.",
      "item": [
        {
          "name": "1 Redis Observation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/redis-observation?userId={{userId}}",
            "description": "Shows Redis seckill stock, activity cache, user dedup key and result cache."
          }
        },
        {
          "name": "2 Reconcile Redis Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/reconcile",
            "description": "Rebuilds Redis stock from MySQL orders and reservations. Formula: redisStock = initialStock - createdOrders - activeReservations."
          }
        },
        {
          "name": "3 List Publish Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/admin/publish-events?page=1&pageSize=20",
            "description": "Lists reliable publish events from seckill admission to RabbitMQ. SENT means published; PENDING/UNKNOWN/DEAD can be retried."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  const list = json.data.records || json.data.list || json.data.content || [];",
                  "  const candidate = list.find(x => x.status !== \"SENT\") || list[0];",
                  "  if (candidate && candidate.id) pm.environment.set(\"publishEventId\", candidate.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4 Retry Publish Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/admin/publish-events/{{publishEventId}}/retry",
            "description": "Retries a PENDING, UNKNOWN or DEAD publish event with the original messageId. Order service idempotency prevents duplicate orders."
          }
        },
        {
          "name": "5 List Dead Letters",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/admin/dead-letters?page=1&pageSize=20",
            "description": "Lists order dead-letter records. To create one first, run: docker exec bupt-ecommerce-rabbitmq rabbitmqadmin publish exchange=seckill.order.exchange routing_key=seckill.order.create payload='not-json-for-dlq-demo'"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  const list = json.data.records || json.data.list || json.data.content || [];",
                  "  if (list.length > 0 && list[0].id) pm.environment.set(\"deadLetterId\", list[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6 Replay Dead Letter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/admin/dead-letters/{{deadLetterId}}/replay",
            "description": "Replays a dead letter. Invalid JSON may become a dead letter again, which is expected for the demo payload."
          }
        }
      ]
    }
