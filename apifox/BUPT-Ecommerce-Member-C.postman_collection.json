    {
      "name": "04 订单查询",
      "item": [
        {
          "name": "我的订单列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  const list = json.data.records || json.data.list || json.data.content || [];",
                  "  if (list.length > 0) pm.environment.set('orderId', list[0].orderId || list[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
