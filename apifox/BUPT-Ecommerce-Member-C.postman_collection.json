            "url": "{{baseUrl}}/api/push/orders/subscribe",
            "description": "CUSTOMER. This is a long-lived SSE request. Use simple-test-page/index.html for the final push demo because it continuously reads ORDER_CREATED events."
          }
        }
      ]
    },
