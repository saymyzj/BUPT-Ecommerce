  "item": [
    {
      "name": "01 认证与用户",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"13800000000\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "PUBLIC. If code=409, the username already exists; change {{username}} or login directly."
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  pm.environment.set('token', json.data.token);",
                  "  if (json.data.user) pm.environment.set('userId', json.data.user.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "PUBLIC. Extracts token and userId."
          }
        },
        {
          "name": "管理员登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) pm.environment.set('adminToken', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin/login",
            "description": "PUBLIC. Extracts adminToken."
          }
        },
        {
          "name": "当前用户",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "description": "CUSTOMER/ADMIN."
          }
        },
        {
          "name": "用户注销",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "CUSTOMER/ADMIN."
          }
        }
      ]
    },
    {
      "name": "02 商品与库存",
      "item": [
        {
          "name": "创建商品",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) pm.environment.set('productId', json.data.productId);"
                ]
              }
            }
