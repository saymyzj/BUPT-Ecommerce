{
  "info": {
    "name": "BUPT Ecommerce - Member A Demo",
    "_postman_id": "b7f44b5e-41c0-4d7c-9f61-member-c",
    "description": "Gateway-based Postman collection for the updated demo: auth, product/stock, Redis seckill, async order, payment, SSE, AI guide, and B+ recovery endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 认证与用户",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"13800000000\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "PUBLIC. If code=409, the username already exists; change {{username}} or login directly."
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  pm.environment.set('token', json.data.token);",
                  "  if (json.data.user) pm.environment.set('userId', json.data.user.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "PUBLIC. Extracts token and userId."
          }
        },
        {
          "name": "管理员登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) pm.environment.set('adminToken', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin/login",
            "description": "PUBLIC. Extracts adminToken."
          }
        },
        {
          "name": "当前用户",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "description": "CUSTOMER/ADMIN."
          }
        },
        {
          "name": "用户注销",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "CUSTOMER/ADMIN."
          }
        }
      ]
    },
    {
      "name": "02 商品与库存",
      "item": [
        {
          "name": "创建商品",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) pm.environment.set('productId', json.data.productId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BUPT AI Noise Cancelling Headphones Pro\",\n  \"price\": 399,\n  \"description\": \"Student-friendly headphones for commuting, self-study and online classes. Active noise cancellation, 8-hour single battery life and about 32 hours with charging case.\"\n}"
            },
            "url": "{{baseUrl}}/api/products",
            "description": "ADMIN. Extracts productId."
          }
        },
        {
          "name": "商品列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?page=1&pageSize=10&keyword=",
            "description": "PUBLIC."
          }
        },
        {
          "name": "商品详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "PUBLIC."
          }
        },
        {
          "name": "设置库存",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 120\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/stock",
            "description": "ADMIN."
          }
        },
        {
          "name": "商品下架",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{productId}}/offline",
            "description": "ADMIN. Sets product status to OFF_SALE. Run this as a standalone admin check; do not run it before creating the seckill activity in the full demo flow."
          }
        }
      ]
    },
    {
      "name": "03 秒杀活动",
      "item": [
        {
          "name": "创建秒杀活动",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) pm.environment.set('activityId', json.data.activityId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"startTime\": \"{{seckillStartTime}}\",\n  \"endTime\": \"{{seckillEndTime}}\",\n  \"seckillPrice\": 199,\n  \"seckillStock\": 100\n}"
            },
            "url": "{{baseUrl}}/api/seckill/activities",
            "description": "ADMIN. Extracts activityId."
          }
        },
        {
          "name": "秒杀活动详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}",
            "description": "PUBLIC."
          }
        },
        {
          "name": "发起秒杀",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/orders",
            "description": "CUSTOMER. QUEUEING only means the request entered MQ; it is not an order-created proof."
          }
        },
        {
          "name": "查询秒杀结果",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data && json.data.orderId) pm.environment.set('orderId', json.data.orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/result",
            "description": "CUSTOMER. Saves orderId when the async order has been created. The returned order status is usually PENDING_PAYMENT."
          }
        },
        {
          "name": "Redis Observation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/redis-observation?userId={{userId}}",
            "description": "ADMIN. Shows Redis stock key, activity cache, user dedup key and result cache for the seckill demo."
          }
        },
        {
          "name": "Reconcile Redis Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/seckill/activities/{{activityId}}/reconcile",
            "description": "ADMIN. Rebuilds Redis seckill stock from MySQL orders and reservation records after Redis data loss."
          }
        }
      ]
    },
    {
      "name": "04 订单查询",
      "item": [
        {
          "name": "我的订单列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.code === 0 && json.data) {",
                  "  const list = json.data.records || json.data.list || json.data.content || [];",
                  "  if (list.length > 0) pm.environment.set('orderId', list[0].orderId || list[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders?page=1&pageSize=10",
            "description": "CUSTOMER. Extracts first orderId when present."
          }
        },
        {
          "name": "订单详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": "CUSTOMER."
          }
        },
        {
          "name": "Pay Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}/pay",
            "description": "CUSTOMER. Changes a PENDING_PAYMENT or CREATED order to PAID. Repeated payment on a PAID order returns the current order."
          }
        },
        {
          "name": "管理员订单列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/admin?page=1&pageSize=10&status={{orderStatus}}",
            "description": "ADMIN. Default orderStatus is PENDING_PAYMENT for the updated demo."
          }
        }
      ]
    },
    {
      "name": "05 AI 智能导购",
      "item": [
        {
          "name": "商品 AI 咨询",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
