            },
            "url": "{{baseUrl}}/api/ai/products/{{productId}}/consult",
            "description": "CUSTOMER/ADMIN. SUCCESS means real LLM path. FALLBACK with code=30001 means configured degradation."
          }
        }
      ]
    },
    {
      "name": "06 实时推送",
      "item": [
        {
          "name": "订单推送 SSE 订阅",
          "request": {
            "method": "GET",
            "header": [
