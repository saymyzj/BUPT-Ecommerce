          }
        },
        {
          "name": "订单详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "description": "CUSTOMER."
