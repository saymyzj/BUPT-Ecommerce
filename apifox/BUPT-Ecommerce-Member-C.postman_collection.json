            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"秒杀耳机\",\n  \"price\": 699,\n  \"description\": \"低延迟无线耳机，适合学生学习和通勤。\"\n}"
            },
            "url": "{{baseUrl}}/api/products",
            "description": "ADMIN. Extracts productId."
          }
        },
        {
          "name": "商品列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?page=1&pageSize=10&keyword=",
            "description": "PUBLIC."
          }
        },
        {
          "name": "商品详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "PUBLIC."
          }
        },
        {
          "name": "设置库存",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 100\n}"
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/stock",
            "description": "ADMIN."
          }
        },
        {
          "name": "商品下架",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{productId}}/offline",
            "description": "ADMIN. Sets product status to OFF_SALE. Run this as a standalone admin check; do not run it before creating the seckill activity in the full demo flow."
          }
        }
      ]
    },
