            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"startTime\": \"2026-06-06T00:00:00\",\n  \"endTime\": \"2026-06-30T23:59:59\",\n  \"seckillPrice\": 199,\n  \"seckillStock\": 20\n}"
            },
            "url": "{{baseUrl}}/api/seckill/activities",
            "description": "ADMIN. Extracts activityId."
          }
        },
        {
          "name": "秒杀活动详情",
          "request": {
